# Trusted website origin for inquiry submissions. SEO URLs use src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=https://www.happytrailsshindigs.com

# Server-only email credentials. Never prefix these with NEXT_PUBLIC_.
# Verify the sender domain in Resend before setting a sender address.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_TO_EMAIL=admin@happytrailsshindigs.com

# No bot-protection secret is required. Configure a Vercel WAF rate-limit rule
# for POST /api/inquiries before public launch; see docs/inquiries.md.
# VERCEL_URL, VERCEL_BRANCH_URL, and VERCEL_PROJECT_PRODUCTION_URL are supplied
# automatically by Vercel and allow inquiries from this project's deployment URLs.
